# Nginx is the only public application listener. Internal service ports are fixed by Compose.
NGINX_PORT=80
# Case-sensitive application prefix; changing it requires a web rebuild.
BASE_PATH=/SEQuiz

# pgAdmin 4 through Nginx at /pgadmin/ (separate login)
SEOPEN_PGADMIN_EMAIL=admin@example.com
SEOPEN_PGADMIN_PASSWORD=change-me

# Frontend environment variables
ORIGIN=http://localhost
PUBLIC_DISPLAY_PLAY_URL=localhost${BASE_PATH}
PUBLIC_PLAY_URL=http://localhost
PUBLIC_BACKEND_URL=http://localhost${BASE_PATH}/backend
PUBLIC_WS_URL=ws://localhost${BASE_PATH}/backend
PUBLIC_CORKBOARD_URL=http://localhost${BASE_PATH}/media
# Compose sets the private CORKBOARD_INTERNAL_URL for server-side thumbnail requests.
# Outside Compose, supply a direct private URL; the public proxy blocks thumbnails.
PUBLIC_SELF_HOSTED=true

# PostgreSQL is internal to Compose; use URL-safe generated credentials.
POSTGRES_DB=se_quiz
POSTGRES_USER=se_quiz
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgres://se_quiz:replace-with-generated-secret@postgres:5432/se_quiz
DB_PROVIDER=postgres
KV_PROVIDER=postgres

# Created only when this email does not exist; startup never resets its password.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-initial-password
ADMIN_SESSION_SECRET=replace-with-generated-secret
# Opt in only for development or demo deployments.
SEED_DEMO_GAMES=false

# Game server CORS
FUIZ_ALLOWED_ORIGINS=["http://localhost"]

# Corkboard CORS
CORKBOARD_ALLOWED_ORIGINS=["http://localhost"]

# Activity and keyword AI are managed by ADMIN at /SEQuiz/admin/llm. See LLM_CONFIGURATION.md.
# Self-hosted web automatically persists its encryption key in STORAGE_PATH/.llm-secrets/encryption.key.
# Keep the web storage volume and back up that key separately from the database.
# No LLM environment variables are required for a new self-hosted setup.
# Cloudflare Workers still require LLM_CONFIG_ENCRYPTION_KEY as a dedicated 32-byte base64 secret.
# ADMIN approves custom/local endpoints directly in /SEQuiz/admin/llm; no endpoint allowlist is needed.
